{
  "name": "ecommerce-mern-starter",
  "private": true,
  "workspaces": [
    "admin",
    "user",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:user\" \"npm run dev:admin\"",
    "start": "npm run dev:backend",
    "install:all": "npm install --workspaces",
    "dev:admin": "npm run dev --workspace admin",
    "dev:user": "npm run dev --workspace user",
    "dev:backend": "npm run dev --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
